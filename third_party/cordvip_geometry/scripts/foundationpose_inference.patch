+def compute_mesh_diameter(model_pts, n_sample=1000):
+    from scipy.spatial.distance import pdist
 
+    if n_sample is None:
+        pts = model_pts
+    else:
+        ids = np.random.choice(
+            len(model_pts), size=min(n_sample, len(model_pts)), replace=False
+        )
+        pts = model_pts[ids]
+    return pdist(pts).max()
+
+
+def compute_crop_window_tf_batch(poses, K, crop_ratio, out_size, mesh_diameter):
+    """Project the mesh bounding sphere to a square image crop."""
+    batch_size = len(poses)
+    radius = mesh_diameter * crop_ratio / 2
+    # Preserve the radius dtype for projection before rounding to pixels.
+    offsets = torch.tensor(
+        [[0, 0, 0], [radius, 0, 0], [-radius, 0, 0], [0, radius, 0], [0, -radius, 0]],
+        device=poses.device,
+    )
+    pts = poses[:, :3, 3].reshape(-1, 1, 3) + offsets.reshape(1, -1, 3)
+    K = torch.as_tensor(K, device=poses.device)
+    projected = (K @ pts.reshape(-1, 3).T).T
+    uvs = projected[:, :2] / projected[:, 2:3]
+    uvs = uvs.reshape(batch_size, -1, 2)
+    center = uvs[:, 0]
+    radius = (
+        torch.abs(uvs - center.reshape(-1, 1, 2))
+        .reshape(batch_size, -1)
+        .max(axis=-1)[0]
+        .reshape(-1)
+    )
+    left = (center[:, 0] - radius).round()
+    right = (center[:, 0] + radius).round()
+    top = (center[:, 1] - radius).round()
+    bottom = (center[:, 1] + radius).round()
+
+    translation = (
+        torch.eye(3, device=poses.device, dtype=poses.dtype)[None]
+        .expand(batch_size, -1, -1)
+        .contiguous()
+    )
+    translation[:, 0, 2] = -left
+    translation[:, 1, 2] = -top
+    scale = (
+        torch.eye(3, device=poses.device, dtype=poses.dtype)[None]
+        .expand(batch_size, -1, -1)
+        .contiguous()
+    )
+    scale[:, 0, 0] = out_size[0] / (right - left)
+    scale[:, 1, 1] = out_size[1] / (bottom - top)
+    return scale @ translation
+
+
+def make_crop_grid(tf_to_crops, image_size, crop_size):
+    """Build the Kornia sampling grid once for RGB and geometry crops."""
+    from kornia.geometry.conversions import normal_transform_pixel
+    from kornia.geometry.linalg import transform_points
+    from kornia.utils import create_meshgrid
+
+    src_norm = normal_transform_pixel(
+        *image_size, device=tf_to_crops.device, dtype=tf_to_crops.dtype
+    )
+    dst_norm = normal_transform_pixel(
+        *crop_size, device=tf_to_crops.device, dtype=tf_to_crops.dtype
+    )
+    normalized = dst_norm @ (tf_to_crops @ src_norm.inverse())
+    grid = create_meshgrid(
+        *crop_size, normalized_coordinates=True, device=tf_to_crops.device
+    )
+    grid = grid.to(tf_to_crops.dtype).expand(len(tf_to_crops), *crop_size, 2)
+    return transform_points(normalized.inverse()[:, None, None], grid)
+
+
+def normalize_xyz_map(xyz_map, poses, mesh_diameters, min_depth):
+    """Center and scale XYZ, preserving the model's per-component clipping."""
+    invalid = xyz_map[:, 2:3] < min_depth
+    xyz_map = xyz_map - poses[:, :3, 3, None, None]
+    xyz_map *= 1 / (mesh_diameters / 2).reshape(-1, 1, 1, 1)
+    invalid = invalid.expand(-1, 3, -1, -1) | (torch.abs(xyz_map) >= 2)
+    xyz_map[invalid] = 0
+    return xyz_map
 
 
