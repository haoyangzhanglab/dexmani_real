+                    mesh_diameter,
+                    glctx,
+                    mesh_tensors,
+                )
+                rows = []
+                for index in range(len(poses)):
+                    rgb_a = (crops.rgbAs[index] * 255).permute(1, 2, 0).cpu().numpy()
+                    rgb_b = (crops.rgbBs[index] * 255).permute(1, 2, 0).cpu().numpy()
+                    depth_a = crops.xyz_mapAs[index, 2].cpu().numpy()
+                    depth_b = crops.xyz_mapBs[index, 2].cpu().numpy()
