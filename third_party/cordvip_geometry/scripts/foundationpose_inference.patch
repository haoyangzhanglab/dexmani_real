+        directory = Path(__file__).resolve().parents[2] / "weights/2024-01-11-20-02-45"
+        self.cfg = OmegaConf.load(directory / "config.yml")
+        if self.cfg.c_in != 6 or self.cfg.use_normal or not self.cfg.normalize_xyz:
+            raise ValueError("Expected the RGB-XYZ score checkpoint")
+        self.model = ScoreNetMultiPair(cfg=self.cfg, c_in=self.cfg.c_in).cuda()
+        checkpoint = torch.load(directory / "model_best.pth")
+        if "model" in checkpoint:
+            checkpoint = checkpoint["model"]
+        self.model.load_state_dict(checkpoint)
+        self.model.eval()
+
+    @torch.inference_mode()
+    def predict(
+        self,
+        rgb,
+        depth,
+        K,
+        ob_in_cams,
+        *,
+        mesh_tensors,
+        glctx,
+        mesh_diameter,
+        get_vis=False,
+    ):
+        crops = make_crop_data_batch(
+            self.cfg.input_resize,
+            ob_in_cams,
+            rgb,
+            depth,
+            K,
+            self.cfg.crop_ratio,
+            mesh_diameter,
+            glctx,
+            mesh_tensors,
+        )
+        rendered = torch.cat([crops.rgbAs, crops.xyz_mapAs], dim=1)
+        observed = torch.cat([crops.rgbBs, crops.xyz_mapBs], dim=1)
+        with torch.autocast("cuda", dtype=torch.float16, enabled=self.amp):
+            output = self.model(rendered, observed, L=len(rendered))
+        # Keep score rounding and tie ordering unchanged.
+        scores = output["score_logit"].float().reshape(-1) + 100
+        torch.cuda.empty_cache()
+        canvas = None
+        if get_vis:
+            canvas = draw_score_grid(crops, scores)
+        return scores, canvas
