+    @torch.inference_mode()
+    def refine(self, pose_data):
+        rendered = torch.cat([pose_data.rgbAs, pose_data.xyz_mapAs], dim=1)
+        observed = torch.cat([pose_data.rgbBs, pose_data.xyz_mapBs], dim=1)
+        with torch.autocast("cuda", dtype=torch.float16, enabled=self.amp):
+            output = self.model(rendered, observed)
+        translation = output["trans"].float()
+        rotation = torch.tanh(output["rot"].float()) * self.cfg.rot_normalizer
+        rotation = so3_exp_map(rotation).permute(0, 2, 1)
+        translation *= pose_data.mesh_diameters[:, None] / 2
+        return egocentric_delta_pose_to_pose(
+            pose_data.poseA,
+            trans_delta=translation,
+            rot_mat_delta=rotation,
+        )
+
+    @torch.inference_mode()
+    def predict(
+        self,
+        rgb,
+        depth,
+        K,
+        ob_in_cams,
+        xyz_map,
+        *,
+        mesh_tensors,
+        glctx,
+        mesh_diameter,
+        iteration=5,
+        get_vis=False,
+    ):
+        poses = torch.as_tensor(ob_in_cams, device="cuda", dtype=torch.float32)
+        rgb = torch.as_tensor(rgb, device="cuda", dtype=torch.float32)
+        depth = torch.as_tensor(depth, device="cuda", dtype=torch.float32)
+        xyz_map = torch.as_tensor(xyz_map, device="cuda", dtype=torch.float32)
+        for _ in range(iteration):
+            crops = make_crop_data_batch(
+                self.cfg.input_resize,
+                poses,
+                rgb,
+                depth,
+                K,
+                self.cfg.crop_ratio,
+                xyz_map,
+                mesh_diameter,
+                glctx,
+                mesh_tensors,
+            )
+            poses = self.refine(crops)
+
+        # Registration releases its larger batch cache.
+        if len(ob_in_cams) > 1:
+            torch.cuda.empty_cache()
+
+        canvas = None
+        if get_vis:
+            canvases = []
+            for stage, candidates in enumerate((ob_in_cams, poses)):
+                crops = make_crop_data_batch(
