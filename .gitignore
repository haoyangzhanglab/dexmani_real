# Experiment data and generated results
/episodes/
/datasets/
/rollouts/
/logs/
*.log

# Local pretrained model weights
/third_party/weights/

# Reconstructed object meshes stay local; point clouds remain tracked.
/assets/pointcloud_template/object/**/mesh/
/assets/pointcloud_template/object/**/*.obj
/assets/pointcloud_template/object/**/*.glb

# Python build and bytecode artifacts
__pycache__/
*.py[cod]
*.so
/build/
/dist/
*.egg-info/
*.egg

# Local editor settings and calibration backups
/.vscode/
/.claude/settings.local.json
**/.DS_Store
